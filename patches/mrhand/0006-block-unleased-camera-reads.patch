-                publications++;
-            }
-        }
-        primed = true;
-        uint64_t now = monoNs();
-        if (statT && now - statT > 5000000000ull) {
-            double dt = (now - statT) / 1e9;
-            printf("{\"event\":\"stats\",\"slot0_hz\":%.1f,\"slot1_hz\":%.1f,\"copy_ms\":%.2f}\n", frames[0] / dt, frames[1] / dt,
-                   copies ? copyNsSum / 1e6 / copies : 0.0);

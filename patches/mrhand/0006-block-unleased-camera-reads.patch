-    }
-    const bool clean = publisher.close();
-    const int code = !clean ? 1 : limit.signal() ? 128 + limit.signal() : publications ? 0 : 1;
-    printf("{\"event\":\"stream_closed\",\"publications\":%llu,\"cleanup_ok\":%s,\"exit_code\":%d}\n",
-           (unsigned long long)publications, clean ? "true" : "false", code);

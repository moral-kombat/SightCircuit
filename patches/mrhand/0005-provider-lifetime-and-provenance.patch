diff --git a/capture/ptgrab.cpp b/capture/ptgrab.cpp
index 4b8f7e3..39e1871 100644
--- a/capture/ptgrab.cpp
+++ b/capture/ptgrab.cpp
@@ -30,20 +30,17 @@
 #include "capture_publication.hpp"
 #include "capture_import.hpp"
